
@page "/"
@using System.Net.Http.Json
@using System.Globalization
@using System.Text.Json.Serialization
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Cinema Booking</PageTitle>

<h1>Cinema Booking</h1>
<p>Available movie screenings</p>

@if (isLoading)
{
    <p>Loading screenings...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <p class="error-message">@errorMessage</p>
    <button @onclick="LoadScreenings">Try again</button>
}
else if (screenings.Count == 0)
{
    <p>No screenings available at the moment.</p>
}
else
{
    <div class="screenings-grid">
        @foreach (var screening in screenings)
        {
            <article class="screening-card" @key="screening.Id">
                <h2>@screening.MovieTitle</h2>

                <p>
                    <strong>Date:</strong>
                    @FormatDate(screening.StartTime)
                </p>

                <p>
                    <strong>Time:</strong>
                    @FormatTime(screening.StartTime)
                </p>

                <p>
                    <strong>Room:</strong>
                    @screening.Room
                </p>
            </article>
        }
    </div>
}

@code {
    private List<ScreeningDto> screenings = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadScreenings();
    }

    private async Task LoadScreenings()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient("CinemaApi");

            var result = await client.GetFromJsonAsync<List<ScreeningDto>>(
                "api/screenings");

            screenings = result ?? new List<ScreeningDto>();
        }
        catch (Exception)
        {
            errorMessage =
                "Could not load screenings. Please check whether the Cinema API is running.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static DateTime ParseDate(string value)
    {
        if (DateTime.TryParse(
                value,
                CultureInfo.InvariantCulture,
                DateTimeStyles.None,
                out var parsed))
        {
            return parsed;
        }

        return DateTime.MinValue;
    }

    private static string FormatDate(string value)
    {
        var date = ParseDate(value);

        return date == DateTime.MinValue
            ? value
            : date.ToString("dd.MM.yyyy");
    }

    private static string FormatTime(string value)
    {
        var date = ParseDate(value);

        return date == DateTime.MinValue
            ? value
            : date.ToString("HH:mm");
    }

    public sealed class ScreeningDto
    {
        [JsonPropertyName("id")]
        public long Id { get; set; }

        [JsonPropertyName("movieTitle")]
        public string MovieTitle { get; set; } = string.Empty;

        [JsonPropertyName("startTime")]
        public string StartTime { get; set; } = string.Empty;

        [JsonPropertyName("room")]
        public string Room { get; set; } = string.Empty;
    }
}
