@page "/screenings/create"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Create Screening</PageTitle>
<h1>Create Screening</h1>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        <p class="mb-2"><strong>@successMessage</strong></p>

        @if (createdScreening is not null)
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">Movie</dt>
                <dd class="col-sm-9">@createdScreening.MovieTitle</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@ScreeningDto.FormatDate(createdScreening.StartTime)</dd>

                <dt class="col-sm-3">Start time</dt>
                <dd class="col-sm-9">@ScreeningDto.FormatTime(createdScreening.StartTime)</dd>

                <dt class="col-sm-3">Room</dt>
                <dd class="col-sm-9">@createdScreening.Room</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">Scheduled</dd>
            </dl>
        }
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<EditForm Model="model" OnValidSubmit="SubmitAsync" FormName="createScreening">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label" for="movie">Movie</label>
        <InputSelect id="movie" @bind-Value="model.MovieTitle" class="form-select">
            <option value="">-- select a movie --</option>
            @foreach (string movie in movies)
            {
                <option value="@movie">@movie</option>
            }
        </InputSelect>
        <ValidationMessage For="() => model.MovieTitle" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="date">Date</label>
        <InputDate id="date" @bind-Value="model.Date" class="form-control" />
        <ValidationMessage For="() => model.Date" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="time">Time</label>
        <InputSelect id="time" @bind-Value="model.Time" class="form-select">
            <option value="">-- select a time --</option>
            @foreach (string time in times)
            {
                <option value="@time">@time</option>
            }
        </InputSelect>
        <ValidationMessage For="() => model.Time" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="room">Room</label>
        <InputSelect id="room" @bind-Value="model.Room" class="form-select">
            <option value="">-- select a room --</option>
            @foreach (string room in rooms)
            {
                <option value="@room">@room</option>
            }
        </InputSelect>
        <ValidationMessage For="() => model.Room" />
    </div>

    @* Task 1: Cancel next to the submit button *@
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
            @(isSubmitting ? "Creating..." : "Create Screening")
        </button>

        <button type="button" class="btn btn-outline-secondary"
                @onclick="Cancel" disabled="@isSubmitting">
            Cancel
        </button>
    </div>
</EditForm>

<h2 class="h4 mt-4">Existing screenings</h2>

@if (isLoadingScreenings)
{
    <p>Loading screenings...</p>
}
else if (!string.IsNullOrEmpty(screeningsError))
{
    <p class="text-danger">@screeningsError</p>
    <button class="btn btn-secondary btn-sm" @onclick="LoadScreenings">Try again</button>
}
else if (FilteredScreenings.Count == 0)
{
    <p>No screenings scheduled for the selected room and date.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Movie</th>
                <th>Date</th>
                <th>Start time</th>
                <th>Room</th>
            </tr>
        </thead>
        <tbody>
            @foreach (ScreeningDto screening in FilteredScreenings)
            {
                <tr @key="screening.Id">
                    <td>@screening.MovieTitle</td>
                    <td>@screening.DisplayDate</td>
                    <td>@screening.DisplayTime</td>
                    <td>@screening.Room</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {

    private static readonly string[] movies =
    {
        "Dune: Part Two",
        "Oppenheimer",
        "The Grand Budapest Hotel",
        "Perfect Days"
    };

    private static readonly string[] rooms = { "Sal 1", "Sal 2", "Sal 3" };

    private static readonly string[] times = { "10:00", "13:00", "16:00", "18:30", "21:00" };

    private ScreeningForm model = new();
    private bool isSubmitting;
    private string? successMessage;
    private string? errorMessage;

    private CreatedScreening? createdScreening;

    private List<ScreeningDto> screenings = new();
    private bool isLoadingScreenings = true;
    private string? screeningsError;

    private IReadOnlyList<ScreeningDto> FilteredScreenings
    {
        get
        {
            IEnumerable<ScreeningDto> query = screenings;

            if (!string.IsNullOrWhiteSpace(model.Room))
            {
                query = query.Where(s =>
                    string.Equals(s.Room, model.Room, StringComparison.OrdinalIgnoreCase));
            }

            if (model.Date is { } date)
            {
                query = query.Where(s => s.StartTimeValue.Date == date.Date);
            }

            return query
                .OrderBy(s => s.Room)
                .ThenBy(s => s.StartTimeValue)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadScreenings();
    }

    private async Task LoadScreenings()
    {
        isLoadingScreenings = true;
        screeningsError = null;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("CinemaApi");

            screenings = await client.GetFromJsonAsync<List<ScreeningDto>>("api/screenings")
                         ?? new List<ScreeningDto>();
        }
        catch (Exception exception)
        {
            Console.WriteLine(exception);
            screenings = new List<ScreeningDto>();
            screeningsError = "Could not load the existing screenings.";
        }
        finally
        {
            isLoadingScreenings = false;
        }
    }

    private void Cancel()
    {
        model = new ScreeningForm();
        successMessage = null;
        errorMessage = null;
        createdScreening = null;
    }

    private async Task SubmitAsync()
    {
        isSubmitting = true;
        successMessage = null;
        errorMessage = null;
        createdScreening = null;

        try
        {
            DateTime startTime = model.Date!.Value.Date.Add(TimeSpan.Parse(model.Time!));

            ScreeningDto? conflict = screenings.FirstOrDefault(s =>
                string.Equals(s.Room, model.Room, StringComparison.OrdinalIgnoreCase)
                && s.StartTimeValue == startTime);

            if (conflict is not null)
            {
                errorMessage =
                    $"The auditorium {conflict.Room} is already booked at that time: " +
                    $"\"{conflict.MovieTitle}\", {conflict.DisplayDate} at {conflict.DisplayTime}. " +
                    "Please choose another time or room.";
                return;
            }

            var payload = new
            {
                movieTitle = model.MovieTitle,
                startTime = startTime.ToString("s"),
                room = model.Room
            };

            HttpClient client = HttpClientFactory.CreateClient("CinemaApi");
            using HttpResponseMessage response =
                await client.PostAsJsonAsync("api/screenings", payload);

            if (response.IsSuccessStatusCode)
            {
                createdScreening = await response.Content.ReadFromJsonAsync<CreatedScreening>();

                successMessage = createdScreening is null
                    ? "The screening was created."
                    : $"Screening #{createdScreening.Id} created.";

                model = new ScreeningForm();

                await LoadScreenings();
            }
            else
            {
                errorMessage = await ReadErrorAsync(response);
            }
        }
        catch (Exception exception)
        {
            Console.WriteLine(exception);
            errorMessage = "Could not reach the Cinema API. Is it running on http://localhost:5287?";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            ApiProblem? problem = await response.Content.ReadFromJsonAsync<ApiProblem>();

            if (!string.IsNullOrWhiteSpace(problem?.Error))
            {
                return problem!.Error!;
            }

            if (!string.IsNullOrWhiteSpace(problem?.Detail))
            {
                return problem!.Detail!;
            }
        }
        catch
        {
            // Body was not JSON - fall through to the generic message.
        }

        return $"Could not create the screening (HTTP {(int)response.StatusCode}).";
    }

    public sealed record ApiProblem(string? Error, string? Detail);

    public sealed record CreatedScreening(long Id, string MovieTitle, string StartTime, string Room);
}